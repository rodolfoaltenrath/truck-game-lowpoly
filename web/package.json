{
  "name": "caminhao-web",
  "private": true,
  "type": "module",
  "scripts": {
    "wasm": "cargo build -p game_core_wasm --target wasm32-unknown-unknown --release && wasm-bindgen --target web --out-dir wasm/pkg ../target/wasm32-unknown-unknown/release/game_core_wasm.wasm",
    "dev": "pnpm wasm && vite --host",
    "build": "pnpm wasm && tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "check": "tsc --noEmit && biome check src e2e",
    "format": "biome check --write src e2e",
    "test:e2e": "playwright test",
    "server": "cargo run --release -p truck_server --"
  },
  "dependencies": {
    "@babylonjs/core": "^9.35.0",
    "@dimforge/rapier3d-compat": "^0.21.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@playwright/test": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  }
}
